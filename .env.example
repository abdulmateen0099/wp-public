PORT=3000
PREFIX=.
# WhatsApp login storage: defaults to Railway's volume mount path, or ./auth locally.
# Attach a persistent Railway volume at /app/auth before linking your account.
# Only override this when that directory is backed by persistent storage.
# AUTH_DIR=/app/auth
# No OWNER_NUMBER needed — every connected WhatsApp account is automatically its own owner.
# Connect 1 account or 10 accounts, they all work independently with no extra config.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
